rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Players collection
    match /players/{playerId} {
      allow get: if isValidId(playerId);
      allow create: if isValidId(playerId) &&
        request.resource.data.keys().hasAll(['id', 'nickname', 'secretHash', 'createdAt', 'lastLogin']) &&
        request.resource.data.id is string && request.resource.data.id.size() <= 64 &&
        request.resource.data.nickname is string && request.resource.data.nickname.size() <= 64 &&
        request.resource.data.secretHash is string && request.resource.data.secretHash.size() <= 128;
      allow update: if isValidId(playerId) && (
        isOwner(playerId) || (resource.data.id == request.resource.data.id)
      );
      allow delete: if false;
    }

    // Pets collection
    match /pets/{petId} {
      allow get: if isValidId(petId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(petId) &&
        request.resource.data.keys().hasAll(['petId', 'ownerId', 'type', 'name', 'personality', 'level', 'hunger', 'happiness', 'energy']) &&
        request.resource.data.petId is string && request.resource.data.petId.size() <= 64 &&
        request.resource.data.name is string && request.resource.data.name.size() <= 64 &&
        request.resource.data.personality is string && request.resource.data.personality.size() <= 32;
      allow update: if isValidId(petId) && (
        resource.data.ownerId == request.resource.data.ownerId
      );
      allow delete: if isValidId(petId);
    }
  }
}
