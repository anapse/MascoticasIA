rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function authPlayerId() {
      return request.auth.token.email.split('@')[0];
    }

    function validId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_-]+$');
    }

    match /players/{playerId} {
      allow get: if signedIn() && authPlayerId() == playerId;

      allow create: if signedIn()
        && authPlayerId() == playerId
        && validId(playerId)
        && request.resource.data.keys().hasOnly(['nickname', 'secretHash'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 64
        && request.resource.data.secretHash is string
        && request.resource.data.secretHash.size() <= 128;

      allow update: if signedIn()
        && authPlayerId() == playerId
        && request.resource.data.keys().hasOnly(['nickname', 'secretHash'])
        && request.resource.data.nickname is string
        && request.resource.data.secretHash is string;

      allow delete: if false;
    }

    match /pets/{petId} {
      allow get: if signedIn()
        && resource.data.ownerId == authPlayerId();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'type'])
        && request.resource.data.ownerId == authPlayerId()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 64
        && request.resource.data.type is string
        && request.resource.data.type.size() >= 1
        && request.resource.data.type.size() <= 32;

      allow update: if signedIn()
        && resource.data.ownerId == authPlayerId()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'type'])
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if signedIn()
        && resource.data.ownerId == authPlayerId();

      allow list: if signedIn()
        && resource.data.ownerId == authPlayerId();
    }

    match /visits/{visitId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'petId', 'timestamp'])
        && request.resource.data.userId == authPlayerId()
        && request.resource.data.petId is string
        && request.resource.data.timestamp is string;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
