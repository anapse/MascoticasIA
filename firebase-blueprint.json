{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "Mascoticas IA player account",
      "type": "object",
      "properties": {
        "nickname": { "type": "string", "maxLength": 64 },
        "secretHash": { "type": "string", "maxLength": 128 }
      },
      "required": ["nickname", "secretHash"]
    },
    "Pet": {
      "title": "Pet",
      "description": "Minimal persistent pet identity",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 64 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 32 }
      },
      "required": ["name", "ownerId", "type"]
    },
    "Visit": {
      "title": "Visit",
      "description": "Minimal Mascoticas visit analytics",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "petId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "petId", "timestamp"]
    }
  },
  "firestore": {
    "/players/{playerId}": {
      "schema": "Player"
    },
    "/pets/{petId}": {
      "schema": "Pet"
    },
    "/visits/{visitId}": {
      "schema": "Visit"
    }
  }
}
